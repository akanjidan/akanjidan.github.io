---
const profile = {
	name: 'Daniel Akanji',
	role: 'PhD Candidate | Marine Robotics & Autonomous Systems | Old Dominion University',
	statement: 'I build and deploy autonomous robotic systems\u2014from mechanical design and sensor integration to estimation, planning, control, and field validation.',
	availability: 'Seeking 2027 Robotics & Autonomy Internships',
	email: 'dakan001@odu.edu',
	github: 'https://github.com/akanjidan',
	linkedin: 'https://www.linkedin.com/in/daniel-akanji',
	resume: '/resume/Daniel_Akanji_Robotics_Resume.pdf',
};

const projects = [
	{
		number: '01',
		slug: 'navigation',
		title: 'BlueROV Navigation & DVL Sensor Integration',
		description: 'Integrated a Nortek Nucleus DVL/ADCP and Hydros 21 CTD with a BlueROV Heavy, spanning mechanical mounting, wiring, BlueOS and ArduSub configuration, external-navigation setup, synchronized log processing, and in-water testing.',
		impact: 'Validated 5,108 of 6,175 bottom-track measurements (82.7%) during pool testing and developed analysis workflows to diagnose bottom-lock acquisition, timing alignment, sensor validity, coordinate-frame consistency, and estimator behavior.',
		tags: ['BlueROV Heavy', 'Nortek Nucleus', 'DVL / ADCP', 'BlueOS', 'ArduSub', 'PyMAVLink', 'Python'],
		image: '/images/bluerov-platform.webp',
		alt: 'Top view of Daniel Akanji’s field-configured BlueROV Heavy platform.',
		caption: 'Field-configured BlueROV Heavy used for sensor-integration and in-water validation work.',
		secondaryImage: '/images/bluerov-trajectory.webp',
		secondaryAlt: 'Reconstructed trajectory from synchronized BlueROV and Nortek navigation data.',
		secondaryCaption: 'Trajectory reconstructed from synchronized ArduPilot and Nortek navigation logs.',
		href: '/projects/bluerov-navigation/',
	},
	{
		number: '02',
		slug: 'sampling',
		title: 'ROV-Based Water & Sediment Sampling for Environmental Monitoring',
		description: 'Designed, fabricated, integrated, and field-tested custom water- and sediment-sampling payloads for PFAS studies, combining CAD, 3D printing, waterproof servo actuation, mechanical linkages, embedded control, and iterative field validation.',
		impact: 'During Lafayette River trials, the system reached a measured 13.2° forward pitch, collected bottom sediment, filled a 250 mL bottle in approximately 30 seconds, and recovered the sample with no visible leakage. The work was accepted for OCEANS 2026 Monterey.',
		tags: ['Fusion 360', '3D Printing', 'Servo Actuation', 'Embedded Control', 'PyMAVLink', 'BlueROV', 'Field Robotics'],
		image: '/images/water-sampler-closeup.webp',
		alt: 'Close-up of the BlueROV Heavy water sampler showing the removable bottle, dual-tube pinch mechanism, tubing, linkage, and ROV mounting frame.',
		caption: 'Water-sampler close-up showing the bottle, tubing, pinch linkage, and ROV mounting frame.',
		secondaryImage: '/images/sediment-field-validation.webp',
		secondaryAlt: 'ROV sediment gripper after field recovery alongside the bottom material retained during sampling.',
		secondaryCaption: 'Lafayette River field validation and recovered bottom sediment.',
		href: '/projects/rov-sampling/',
	},
	{
		number: '03',
		slug: 'autonomy',
		title: 'JaiaBot Fleet River-Flow Estimation',
		description: 'Deployed a three-robot JaiaBot fleet as Lagrangian floats in the Lafayette River, then converted synchronized trajectories into velocity observations and trained radial-basis support-vector regression models to estimate the surrounding flow field.',
		impact: 'The learned model achieved 0.02 m/s flow-vector RMSE. When used to predict a held-out robot trajectory, the final-position error was 2.97 m—within the stated 3 m GPS accuracy of the field platform.',
		tags: ['JaiaBot Fleet', 'MATLAB', 'RBF-SVR', 'Field Robotics', 'Multi-Robot Systems', 'Data Analysis'],
		image: '/images/jaiabot-fleet.webp',
		alt: 'Three red JaiaBot aquatic robots arranged inside their transport case before a field deployment.',
		caption: 'Portable three-robot JaiaBot fleet prepared for Lafayette River deployment.',
		secondaryImage: '/images/jaiabot-deployment.webp',
		secondaryAlt: 'Three JaiaBot robots, highlighted with circles, drifting as a fleet during a Lafayette River field trial.',
		secondaryCaption: 'Three-robot field deployment used to collect synchronized river-flow observations.',
		href: '/projects/river-flow/',
	},
];

const research = [
	{
		year: '2026',
		title: 'Uncertainty-Aware Estimation, Planning, and Control for Tracking Multiple Drifting Patches in Flow Fields',
		venue: 'Frontiers in Robotics and AI',
		kind: 'Journal Article',
		url: 'https://www.frontiersin.org/journals/robotics-and-ai/articles/10.3389/frobt.2026.1842384/full',
	},
	{
		year: '2026',
		title: 'Predictive, Degradation-Aware Sensor Scheduling for Underwater Sonar Navigation',
		venue: 'IEEE International Symposium on Robotic and Sensors Environments',
		kind: 'Conference Paper',
		url: 'https://doi.org/10.1109/ROSE69181.2026.11570985',
	},
	{
		year: '2026',
		title: 'Design and Field Evaluation of an Integrated ROV-Based Water and Sediment Sampling System for PFAS Studies',
		venue: 'OCEANS 2026 Monterey',
		kind: 'Accepted Conference Paper',
		url: '/projects/rov-sampling/',
	},
	{
		year: '2025',
		title: 'River Flow Prediction Using a Fleet of Aquatic Robots',
		venue: 'PIANC SMART Rivers',
		kind: 'Conference Presentation',
		url: '/projects/river-flow/',
	},
];

const strengths = [
	{ title: 'Build across the stack', text: 'I work from CAD, fabrication, wiring, and embedded hardware through sensing, autonomy software, controls, data analysis, and system validation.' },
	{ title: 'Test under real conditions', text: 'I validate robotic systems in tanks, pools, rivers, and field environments, then turn failures into mechanical, software, and configuration improvements.' },
	{ title: 'Research with deployment in mind', text: 'I combine rigorous modeling and experimentation with the practical goal of producing robotic systems that are measurable, reproducible, and useful outside the lab.' },
];

const about = 'I am a PhD candidate at Old Dominion University and a former research intern at the Institute for Systems and Robotics in Lisbon. My work spans underwater robot navigation, DVL/ADCP and CTD integration, robotic environmental sampling, multi-robot coordination, state estimation, planning, and feedback control. I work across Python, C++, MATLAB, ROS/ROS2, Linux, BlueOS/ArduSub, Fusion 360, embedded platforms, simulation, and field experimentation.';

const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={`${profile.name} - robotics engineer and PhD candidate working across autonomous systems, marine robotics, sensing, planning, and control.`} />
		<meta name="theme-color" content="#f7fbff" />
		<meta property="og:title" content={`${profile.name} - Robotics Portfolio`} />
		<meta property="og:description" content={profile.statement} />
		<meta property="og:type" content="website" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{profile.name} - Robotics Engineer</title>
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>
		<header class="site-header">
			<a class="wordmark" href="#top" aria-label={`${profile.name}, back to top`}><span>DA</span><span class="wordmark-dot"></span></a>
			<nav aria-label="Primary navigation">
				<a href="#work">Work</a><a href="#research">Research</a><a href="#about">About</a>
				<a class="resume-nav" href={profile.resume} target="_blank" rel="noreferrer">Resume <span aria-hidden="true">&nearr;</span></a>
			</nav>
		</header>

		<main id="main">
			<section class="hero" id="top" aria-labelledby="hero-title">
				<div class="hero-meta reveal">
					<div class="eyebrow"><span class="status-dot"></span>{profile.availability}</div>
					<p>{profile.role}</p>
				</div>
				<h1 id="hero-title" class="reveal delay-1">Robotics engineer.<br /><em>Practical builder.</em></h1>
				<div class="hero-footer reveal delay-2">
					<p>{profile.statement}</p>
					<div class="hero-actions">
						<a href={profile.github} target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">&nearr;</span></a>
						<a href={profile.linkedin} target="_blank" rel="noreferrer">LinkedIn <span aria-hidden="true">&nearr;</span></a>
					</div>
					<a class="round-link" href="#work" aria-label="Jump to selected work"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v15m0 0 6-6m-6 6-6-6" /></svg></a>
				</div>
				<div class="orbit orbit-one"></div><div class="orbit orbit-two"></div>
			</section>

			<section class="work section" id="work" aria-labelledby="work-title">
				<div class="section-heading"><p class="kicker">Selected work</p><h2 id="work-title">Robotics from concept<br />to <em>the real world.</em></h2></div>
				<div class="project-list">
					{projects.map((project) => (
						<article class="project" id={project.slug}>
							<div class="project-header"><div class="project-number">/{project.number}</div><h3>{project.title}</h3></div>
							<div class={`project-media${project.secondaryImage ? ' split' : ''}`}>
								<figure class="project-visual"><img src={project.image} alt={project.alt} loading="lazy" decoding="async" /><figcaption>{project.caption}</figcaption></figure>
								{project.secondaryImage && <figure class="project-visual"><img src={project.secondaryImage} alt={project.secondaryAlt || ''} loading="lazy" decoding="async" /><figcaption>{project.secondaryCaption}</figcaption></figure>}
							</div>
							<div class="project-details">
								<p class="description">{project.description}</p><p class="impact"><span>Outcome</span>{project.impact}</p>
								<ul class="tags" aria-label="Technologies and skills">{project.tags.map((tag) => <li>{tag}</li>)}</ul>
								<a class="project-link" href={project.href}>Explore project <span aria-hidden="true">→</span></a>
							</div>
						</article>
					))}
				</div>
			</section>

			<section class="research section" id="research" aria-labelledby="research-title">
				<div class="section-heading research-heading"><p class="kicker">Selected research</p><h2 id="research-title">From field questions<br />to <em>research contributions.</em></h2></div>
				<div class="research-list">
					{research.map((item) => (
						<a class="research-item" href={item.url} target={item.url.startsWith('http') ? '_blank' : undefined} rel={item.url.startsWith('http') ? 'noreferrer' : undefined}>
							<span class="research-year">{item.year}</span>
							<span class="research-copy"><strong>{item.title}</strong><small>{item.venue} / {item.kind}</small></span>
							<span class="research-arrow" aria-hidden="true">&nearr;</span>
						</a>
					))}
				</div>
			</section>

			<section class="about section" id="about" aria-labelledby="about-title">
				<div class="about-intro"><p class="kicker">How I work</p><h2 id="about-title">I like the space between<br /><em>&ldquo;why?&rdquo; and &ldquo;it works.&rdquo;</em></h2></div>
				<div class="about-copy"><p>{about}</p></div>
				<div class="strength-grid">
					{strengths.map((strength, index) => <div class="strength"><span>0{index + 1}</span><h3>{strength.title}</h3><p>{strength.text}</p></div>)}
				</div>
			</section>

			<section class="contact section" id="contact" aria-labelledby="contact-title">
				<p class="kicker">Start a conversation</p><h2 id="contact-title">Building robotics for<br /><em>the real world?</em></h2>
				<p class="contact-copy">I am seeking 2027 robotics and autonomy internships where I can contribute across embedded systems, sensing, navigation, planning, control, simulation, and hands-on robotic system integration. I am especially interested in teams that build and deploy physical robots in challenging real-world environments.</p>
				<div class="contact-actions"><a class="email-link" href={`mailto:${profile.email}`}>Email me <span aria-hidden="true">&nearr;</span></a><a class="secondary-link" href={profile.resume} target="_blank" rel="noreferrer">Download resume</a><a class="secondary-link" href={profile.github} target="_blank" rel="noreferrer">GitHub &nearr;</a></div>
			</section>
		</main>

		<footer><p>&copy; {year} {profile.name}</p><div><a href={`mailto:${profile.email}`}>Email</a><a href={profile.github} target="_blank" rel="noreferrer">GitHub &nearr;</a><a href={profile.linkedin} target="_blank" rel="noreferrer">LinkedIn &nearr;</a></div></footer>
	</body>
</html>

<style is:global>
	@import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@300;400;500&family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap');
	:root { --paper:#f7fbff; --surface:#ffffff; --ink:#07162b; --muted:#52657a; --accent:#155eef; --accent-bright:#38bdf8; --soft-green:#e9f4ff; --deep:#04142b; --deep-2:#0a3977; --line:rgba(7,22,43,.14); --display:'Space Grotesk','Segoe UI',sans-serif; --sans:'Inter','Segoe UI',Arial,sans-serif; --mono:'DM Mono',monospace; }
	* { box-sizing:border-box; }
	html { scroll-behavior:smooth; }
	body { margin:0; background:var(--paper); color:var(--ink); font-family:var(--sans); overflow-x:hidden; }
	::selection { color:#fff; background:var(--accent); }
	:focus-visible { outline:3px solid var(--accent-bright); outline-offset:4px; }
	a { color:inherit; }
	img { display:block; max-width:100%; }
	.skip-link { position:fixed; top:-4rem; left:1rem; z-index:20; padding:.8rem 1rem; background:var(--accent); color:white; }
	.skip-link:focus { top:1rem; }
	.site-header { height:92px; padding:0 clamp(1.25rem,5vw,5rem); display:flex; align-items:center; justify-content:space-between; border-bottom:1px solid var(--line); position:sticky; top:0; z-index:10; background:rgba(247,251,255,.9); backdrop-filter:blur(16px) saturate(150%); box-shadow:0 8px 30px rgba(21,94,239,.045); }
	.wordmark { display:flex; align-items:center; gap:.25rem; font:600 1.1rem var(--sans); text-decoration:none; letter-spacing:-.05em; }
	.wordmark-dot { width:.38rem; height:.38rem; background:var(--accent-bright); border-radius:50%; box-shadow:0 0 0 .22rem rgba(56,189,248,.15); }
	nav { display:flex; align-items:center; gap:clamp(1rem,3vw,3rem); }
	nav a, footer a { font:400 .76rem var(--mono); text-transform:uppercase; letter-spacing:.08em; text-decoration:none; }
	nav a:hover, footer a:hover { color:var(--accent); }
	.resume-nav { border:1px solid var(--accent); color:var(--accent); border-radius:10rem; padding:.65rem .9rem; }
	.resume-nav:hover { color:#fff; background:var(--accent); }
	.hero { min-height:calc(100vh - 92px); padding:clamp(3rem,8vh,7rem) clamp(1.25rem,5vw,5rem) 3rem; display:flex; flex-direction:column; justify-content:space-between; position:relative; overflow:hidden; background:radial-gradient(circle at 91% 12%,rgba(56,189,248,.15),transparent 25%),linear-gradient(145deg,#fff 0%,var(--paper) 54%,#eaf4ff 100%); }
	.hero-meta { display:flex; justify-content:space-between; align-items:center; gap:2rem; position:relative; z-index:1; }
	.hero-meta>p { max-width:36rem; margin:0; text-align:right; color:var(--muted); font-size:.86rem; line-height:1.45; }
	.eyebrow,.kicker { font:400 .76rem var(--mono); text-transform:uppercase; letter-spacing:.12em; }
	.eyebrow { display:flex; align-items:center; gap:.7rem; }
	.status-dot { width:.55rem; height:.55rem; border-radius:50%; background:var(--accent-bright); box-shadow:0 0 0 .25rem rgba(56,189,248,.18); }
	h1 { max-width:72rem; font-family:var(--display); font-size:clamp(3.6rem,8.5vw,8.5rem); line-height:.92; letter-spacing:-.065em; font-weight:600; margin:2rem 0; position:relative; z-index:1; text-wrap:balance; }
	h1 em,h2 em { font-family:inherit; font-style:normal; font-weight:inherit; }
	h1 em { display:inline-block; color:var(--accent); }
	.hero-footer { display:grid; grid-template-columns:minmax(18rem,38rem) auto auto; gap:clamp(1.5rem,4vw,4rem); align-items:end; position:relative; z-index:1; }
	.hero-footer>p { max-width:42rem; margin:0; font-size:clamp(1rem,1.45vw,1.2rem); line-height:1.65; }
	.hero-actions { display:flex; flex-direction:column; gap:.55rem; }
	.hero-actions a { width:max-content; font:.75rem var(--mono); text-transform:uppercase; letter-spacing:.08em; text-decoration:none; border-bottom:1px solid var(--line); padding-bottom:.25rem; }
	.hero-actions span { color:var(--accent); }
	.round-link { width:4.5rem; height:4.5rem; border:1px solid var(--accent); color:var(--accent); border-radius:50%; display:grid; place-items:center; transition:.25s; background:rgba(255,255,255,.55); }
	.round-link:hover { background:var(--accent); color:#fff; transform:translateY(4px); }
	.round-link svg { width:1.3rem; fill:none; stroke:currentColor; stroke-width:1.5; }
	.orbit { position:absolute; border:1px solid rgba(21,94,239,.2); border-radius:50%; pointer-events:none; }
	.orbit-one { width:38vw; height:38vw; right:-15vw; top:-12vw; }
	.orbit-two { width:22vw; height:22vw; right:-3vw; top:-4vw; }
	.section { padding:clamp(5rem,10vw,9rem) clamp(1.25rem,5vw,5rem); }
	.work { background:linear-gradient(145deg,var(--deep) 0%,#061f43 48%,var(--deep-2) 100%); color:#fff; position:relative; }
	.work::before { content:''; position:absolute; inset:0; pointer-events:none; background-image:linear-gradient(rgba(255,255,255,.025) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.025) 1px,transparent 1px); background-size:48px 48px; mask-image:linear-gradient(to bottom,black,transparent 38%); }
	.work>* { position:relative; }
	.section-heading,.about-intro { display:grid; grid-template-columns:minmax(8rem,1fr) 3fr; gap:2rem; margin-bottom:clamp(4rem,8vw,8rem); }
	.kicker { margin:.6rem 0 0; color:var(--accent); }
	h2 { font-family:var(--display); font-size:clamp(2.35rem,4.8vw,5rem); line-height:1.02; letter-spacing:-.05em; font-weight:600; margin:0; text-wrap:balance; }
	.project { border-top:1px solid rgba(255,255,255,.18); padding:clamp(3rem,6vw,6rem) 0; scroll-margin-top:7.5rem; }
	.project:last-child { border-bottom:1px solid rgba(255,255,255,.18); }
	.project-header { display:grid; grid-template-columns:minmax(4rem,.6fr) 3fr; gap:2rem; margin-bottom:2.5rem; }
	.project-number { color:var(--accent); font:.75rem var(--mono); padding-top:.5rem; }
	.project h3,.strength h3 { font-family:var(--display); font-size:clamp(1.8rem,3.15vw,3.25rem); line-height:1.05; letter-spacing:-.045em; margin:0; font-weight:600; text-wrap:balance; }
	.project-media { margin:0 0 2.5rem calc(16.66% + 1.35rem); display:grid; gap:1rem; }
	.project-media.split { grid-template-columns:repeat(2,minmax(0,1fr)); }
	.project-visual { margin:0; overflow:hidden; min-width:0; }
	.project-visual img { width:100%; aspect-ratio:16/7.5; object-fit:cover; background:#020b18; filter:saturate(.95) contrast(1.04); transition:transform .7s cubic-bezier(.2,.7,.2,1),filter .3s; box-shadow:0 24px 70px rgba(0,7,20,.3); }
	.project-media.split .project-visual img { aspect-ratio:4/3; }
	.project-media.split .project-visual:nth-child(2) img { object-fit:contain; background:#fff; }
	.project:nth-child(3) .project-visual img { object-fit:contain; background:#fff; }
	.project:hover .project-visual img { transform:scale(1.015); filter:saturate(1) contrast(1.03); }
	.project-visual figcaption { margin-top:.7rem; color:#a9cffc; font:.7rem/1.55 var(--mono); text-transform:uppercase; letter-spacing:.06em; }
	.project-details { margin-left:calc(16.66% + 1.35rem); display:grid; grid-template-columns:1.3fr 1fr; column-gap:clamp(2rem,5vw,6rem); }
	.project-details .description { color:#d3e5fb; line-height:1.75; margin:0; }
	.project-details .impact { color:#fff; line-height:1.7; font-size:1rem; margin:0; }
	.impact span { display:block; color:#78c9ff; font:.72rem var(--mono); text-transform:uppercase; letter-spacing:.1em; margin-bottom:.65rem; }
	.tags { grid-column:1/-1; list-style:none; display:flex; gap:.6rem; flex-wrap:wrap; padding:1.75rem 0 0; margin:0; }
	.tags li { border:1px solid rgba(141,188,247,.4); background:rgba(21,94,239,.12); border-radius:10rem; padding:.45rem .75rem; font:.72rem var(--mono); }
	.project-link { grid-column:1/-1; justify-self:start; margin-top:1.6rem; color:#fff; font:500 .8rem var(--mono); text-transform:uppercase; letter-spacing:.08em; text-decoration:none; border-bottom:1px solid var(--accent-bright); padding-bottom:.45rem; transition:color .2s,gap .2s; }
	.project-link span { color:var(--accent-bright); display:inline-block; margin-left:.45rem; transition:transform .2s; }
	.project-link:hover span { transform:translateX(.3rem); }
	.research { background:var(--surface); }
	.research-heading { margin-bottom:clamp(3rem,6vw,6rem); }
	.research-list { margin-left:calc(25% + .5rem); border-top:1px solid var(--line); }
	.research-item { display:grid; grid-template-columns:5rem 1fr 2rem; gap:1.5rem; align-items:start; padding:2rem 0; border-bottom:1px solid var(--line); text-decoration:none; transition:color .2s,padding .25s; }
	.research-item:hover { color:var(--accent); padding-left:.6rem; background:linear-gradient(90deg,rgba(21,94,239,.055),transparent 72%); }
	.research-year { font:.78rem var(--mono); color:var(--accent); padding-top:.3rem; }
	.research-copy { display:flex; flex-direction:column; gap:.7rem; }
	.research-copy strong { max-width:58rem; font-family:var(--display); font-size:clamp(1rem,1.7vw,1.35rem); font-weight:600; line-height:1.4; }
	.research-copy small { color:var(--muted); font:.74rem/1.5 var(--mono); text-transform:uppercase; letter-spacing:.07em; }
	.research-arrow { justify-self:end; color:var(--accent); }
	.about { background:linear-gradient(135deg,var(--soft-green),#dceeff); }
	.about-copy { margin-left:calc(25% + .5rem); max-width:58rem; margin-bottom:4rem; }
	.about-copy p { margin:0; color:var(--muted); font-size:clamp(1rem,1.45vw,1.2rem); line-height:1.85; }
	.strength-grid { margin-left:calc(25% + .5rem); display:grid; grid-template-columns:repeat(3,1fr); border-top:1px solid var(--line); }
	.strength { padding:2.2rem 2rem 1rem 0; border-right:1px solid var(--line); }
	.strength+.strength { padding-left:2rem; }
	.strength:last-child { border-right:0; }
	.strength>span { font:.78rem var(--mono); color:var(--accent); }
	.strength h3 { font-size:clamp(1.45rem,2.1vw,2rem); margin-top:3.5rem; }
	.strength p { color:var(--muted); line-height:1.7; font-size:1rem; }
	.contact { min-height:72vh; display:flex; flex-direction:column; align-items:flex-start; justify-content:center; color:#fff; background:radial-gradient(circle at 82% 16%,rgba(56,189,248,.23),transparent 28%),linear-gradient(135deg,var(--deep),#082c60 68%,#0b4da0); }
	.contact h2 { margin:1.5rem 0 2rem; }
	.contact-copy { max-width:44rem; color:#c9ddf6; font-size:clamp(1rem,1.5vw,1.2rem); line-height:1.7; margin:0 0 2.5rem; }
	.contact-actions { display:flex; align-items:center; gap:2rem; }
	.email-link { color:#fff; font:500 clamp(1.1rem,2vw,1.5rem) var(--sans); text-decoration:none; border-bottom:2px solid var(--accent-bright); padding-bottom:.5rem; }
	.email-link span { color:var(--accent-bright); }
