---
interface Fact { value: string; label: string; }
interface WorkflowStep { number: string; title: string; text: string; }
interface Contribution { title: string; text: string; }
interface Result { value: string; label: string; detail: string; }
interface GalleryItem { src: string; alt: string; caption: string; fit?: 'cover' | 'contain'; }
interface NextProject { href: string; label: string; }

interface Props {
	title: string;
	eyebrow: string;
	deck: string;
	heroImage: string;
	heroAlt: string;
	heroCaption: string;
	facts: Fact[];
	problem: string;
	approach: string;
	workflow: WorkflowStep[];
	contributions: Contribution[];
	results: Result[];
	gallery: GalleryItem[];
	lessons: string[];
	nextProject: NextProject;
	publicationHref?: string;
	publicationLabel?: string;
}

const {
	title,
	eyebrow,
	deck,
	heroImage,
	heroAlt,
	heroCaption,
	facts,
	problem,
	approach,
	workflow,
	contributions,
	results,
	gallery,
	lessons,
	nextProject,
	publicationHref,
	publicationLabel = 'View publication',
} = Astro.props;

const email = 'dakan001@odu.edu';
const resume = '/resume/Daniel_Akanji_Robotics_Resume.pdf';
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={deck} />
		<meta name="theme-color" content="#f7fbff" />
		<meta property="og:title" content={`${title} | Daniel Akanji`} />
		<meta property="og:description" content={deck} />
		<meta property="og:type" content="website" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title} | Daniel Akanji</title>
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>
		<header class="site-header">
			<a class="wordmark" href="/" aria-label="Daniel Akanji, home"><span>DA</span><span class="wordmark-dot"></span></a>
			<nav aria-label="Primary navigation">
				<a href="/#work">Work</a><a href="/#research">Research</a><a href="/#about">About</a>
				<a class="resume-nav" href={resume} target="_blank" rel="noreferrer">Resume <span aria-hidden="true">↗</span></a>
			</nav>
		</header>

		<main id="main">
			<section class="project-hero">
				<a class="back-link" href="/#work"><span aria-hidden="true">←</span> Selected work</a>
				<div class="hero-copy">
					<p class="eyebrow">{eyebrow}</p>
					<h1>{title}</h1>
					<p class="deck">{deck}</p>
				</div>
				<figure class="hero-visual">
					<img src={heroImage} alt={heroAlt} decoding="async" />
					<figcaption>{heroCaption}</figcaption>
				</figure>
			</section>

			<section class="fact-band" aria-label="Project highlights">
				{facts.map((fact) => <div><strong>{fact.value}</strong><span>{fact.label}</span></div>)}
			</section>

			<section class="story section">
				<div class="section-label"><span>01</span><p>Context</p></div>
				<div class="story-grid">
					<div><h2>The problem</h2><p>{problem}</p></div>
					<div><h2>The approach</h2><p>{approach}</p></div>
				</div>
			</section>

			<section class="system section">
				<div class="section-label light"><span>02</span><p>System workflow</p></div>
				<div class="workflow">
					{workflow.map((step, index) => (
						<div class="workflow-item">
							<div class="workflow-card"><span>{step.number}</span><h3>{step.title}</h3><p>{step.text}</p></div>
							{index < workflow.length - 1 && <span class="workflow-arrow" aria-hidden="true">→</span>}
						</div>
					))}
				</div>
			</section>

			<section class="build section">
				<div class="section-label"><span>03</span><p>My contribution</p></div>
				<div class="build-heading"><h2>What I built<br />and validated.</h2><p>My role crossed hardware, software, data, and field experimentation rather than stopping at a single subsystem.</p></div>
				<div class="contribution-grid">
					{contributions.map((item, index) => <article><span>0{index + 1}</span><h3>{item.title}</h3><p>{item.text}</p></article>)}
				</div>
			</section>

			<section class="results section">
				<div class="section-label light"><span>04</span><p>Evidence</p></div>
				<div class="results-heading"><h2>Measured outcomes,<br />not just claims.</h2></div>
				<div class="result-grid">
					{results.map((result) => <article><strong>{result.value}</strong><h3>{result.label}</h3><p>{result.detail}</p></article>)}
				</div>
			</section>

			<section class="gallery section">
				<div class="section-label"><span>05</span><p>Project evidence</p></div>
				<div class="gallery-grid">
					{gallery.map((item) => <figure class:list={{ contain: item.fit === 'contain' }}><img src={item.src} alt={item.alt} loading="lazy" decoding="async" /><figcaption>{item.caption}</figcaption></figure>)}
				</div>
			</section>

			<section class="lessons section">
				<div class="section-label"><span>06</span><p>Engineering judgment</p></div>
				<div class="lessons-heading"><h2>What the work<br />taught me.</h2></div>
				<ol>{lessons.map((lesson) => <li>{lesson}</li>)}</ol>
				{publicationHref && <a class="publication-link" href={publicationHref} target="_blank" rel="noreferrer">{publicationLabel} <span aria-hidden="true">↗</span></a>}
			</section>

			<section class="next-project">
				<p>Continue exploring</p>
				<a href={nextProject.href}>{nextProject.label}<span aria-hidden="true">→</span></a>
			</section>

			<section class="contact">
				<p>Building robotics for the real world?</p>
				<h2>Let’s talk.</h2>
				<a href={`mailto:${email}`}>{email} <span aria-hidden="true">↗</span></a>
			</section>
		</main>

		<footer><p>© {year} Daniel Akanji</p><div><a href="/">Home</a><a href={resume} target="_blank" rel="noreferrer">Resume ↗</a><a href={`mailto:${email}`}>Email</a></div></footer>
	</body>
</html>

<style is:global>
	@import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@300;400;500&family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap');
	:root { --paper:#f7fbff; --surface:#fff; --ink:#07162b; --muted:#52657a; --accent:#155eef; --sky:#38bdf8; --deep:#04142b; --deep-2:#0a3977; --line:rgba(7,22,43,.14); --display:'Space Grotesk','Segoe UI',sans-serif; --sans:'Inter','Segoe UI',Arial,sans-serif; --mono:'DM Mono',monospace; }
	* { box-sizing:border-box; }
	html { scroll-behavior:smooth; }
	body { margin:0; background:var(--paper); color:var(--ink); font-family:var(--sans); overflow-x:hidden; }
	::selection { color:#fff; background:var(--accent); }
	:focus-visible { outline:3px solid var(--sky); outline-offset:4px; }
	a { color:inherit; }
	img { display:block; max-width:100%; }
	.skip-link { position:fixed; top:-4rem; left:1rem; z-index:20; padding:.8rem 1rem; background:var(--accent); color:#fff; }
	.skip-link:focus { top:1rem; }
	.site-header { height:92px; padding:0 clamp(1.25rem,5vw,5rem); display:flex; align-items:center; justify-content:space-between; border-bottom:1px solid var(--line); position:sticky; top:0; z-index:10; background:rgba(247,251,255,.92); backdrop-filter:blur(16px) saturate(150%); }
	.wordmark { display:flex; align-items:center; gap:.25rem; font:600 1.1rem var(--sans); text-decoration:none; letter-spacing:-.05em; }
	.wordmark-dot { width:.38rem; height:.38rem; background:var(--sky); border-radius:50%; box-shadow:0 0 0 .22rem rgba(56,189,248,.15); }
	nav { display:flex; align-items:center; gap:clamp(1rem,3vw,3rem); }
	nav a, footer a { font:400 .76rem var(--mono); text-transform:uppercase; letter-spacing:.08em; text-decoration:none; }
	nav a:hover, footer a:hover { color:var(--accent); }
	.resume-nav { border:1px solid var(--accent); color:var(--accent); border-radius:10rem; padding:.65rem .9rem; }
	.resume-nav:hover { color:#fff; background:var(--accent); }
	.project-hero { padding:clamp(2.5rem,6vw,6rem) clamp(1.25rem,5vw,5rem) clamp(4rem,8vw,8rem); background:radial-gradient(circle at 92% 5%,rgba(56,189,248,.18),transparent 28%),linear-gradient(145deg,#fff,var(--paper) 62%,#e5f3ff); }
	.back-link { display:inline-flex; align-items:center; gap:.65rem; color:var(--accent); font:.76rem var(--mono); text-decoration:none; text-transform:uppercase; letter-spacing:.08em; }
	.hero-copy { max-width:75rem; margin:clamp(4rem,9vw,8rem) 0 clamp(3rem,6vw,5rem); }
	.eyebrow,.section-label { font:400 .76rem var(--mono); text-transform:uppercase; letter-spacing:.11em; }
	.eyebrow { color:var(--accent); margin:0 0 1.5rem; }
	h1 { max-width:72rem; margin:0; font:600 clamp(3.3rem,7.4vw,7.7rem)/.95 var(--display); letter-spacing:-.065em; text-wrap:balance; }
	.deck { max-width:58rem; color:var(--muted); font-size:clamp(1.05rem,1.7vw,1.35rem); line-height:1.7; margin:2.2rem 0 0; }
	.hero-visual { margin:0 0 0 16.66%; }
	.hero-visual img { width:100%; max-height:70vh; aspect-ratio:16/8.2; object-fit:cover; background:#06162e; box-shadow:0 30px 85px rgba(9,42,85,.18); }
	figcaption { margin-top:.75rem; color:var(--muted); font:.72rem/1.55 var(--mono); text-transform:uppercase; letter-spacing:.06em; }
	.fact-band { display:grid; grid-template-columns:repeat(auto-fit,minmax(12rem,1fr)); padding:0 clamp(1.25rem,5vw,5rem); background:linear-gradient(135deg,var(--deep),var(--deep-2)); color:#fff; }
	.fact-band div { min-height:10rem; padding:2.4rem 2rem; border-left:1px solid rgba(255,255,255,.16); display:flex; flex-direction:column; justify-content:center; gap:.6rem; }
	.fact-band div:last-child { border-right:1px solid rgba(255,255,255,.16); }
	.fact-band strong { font:600 clamp(1.65rem,3vw,2.65rem) var(--display); letter-spacing:-.04em; }
	.fact-band span { color:#a9cffc; font:.7rem/1.5 var(--mono); text-transform:uppercase; letter-spacing:.07em; }
	.section { padding:clamp(5rem,10vw,9rem) clamp(1.25rem,5vw,5rem); }
	.section-label { display:flex; gap:1.1rem; align-items:center; color:var(--accent); margin-bottom:clamp(3rem,6vw,6rem); }
	.section-label span { border:1px solid currentColor; width:2rem; height:2rem; border-radius:50%; display:grid; place-items:center; font-size:.64rem; }
	.section-label p { margin:0; }
	.section-label.light { color:#78c9ff; }
	.story { background:var(--surface); }
	.story-grid { margin-left:16.66%; display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:clamp(3rem,8vw,9rem); }
	h2 { margin:0; font:600 clamp(2.3rem,4.8vw,5rem)/1 var(--display); letter-spacing:-.052em; text-wrap:balance; }
	.story-grid h2 { font-size:clamp(1.8rem,3vw,3rem); margin-bottom:1.5rem; }
	.story-grid p,.build-heading p,.contribution-grid p,.result-grid p { color:var(--muted); line-height:1.8; margin:0; }
	.system,.results { color:#fff; background:linear-gradient(145deg,var(--deep),#061f43 48%,var(--deep-2)); }
	.workflow { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); align-items:stretch; }
	.workflow-item { display:grid; grid-template-columns:1fr auto; align-items:center; min-width:0; }
	.workflow-card { height:100%; min-height:17rem; padding:2rem; border:1px solid rgba(141,188,247,.35); background:rgba(21,94,239,.11); }
	.workflow-card>span { color:#78c9ff; font:.7rem var(--mono); }
	.workflow-card h3,.contribution-grid h3,.result-grid h3 { font:600 1.3rem/1.2 var(--display); letter-spacing:-.025em; margin:3rem 0 1rem; }
	.workflow-card p { color:#c9ddf6; font-size:.92rem; line-height:1.65; margin:0; }
	.workflow-arrow { color:var(--sky); font-size:1.35rem; margin:0 .6rem; }
	.build { background:#edf6ff; }
	.build-heading,.results-heading,.lessons-heading { margin-left:16.66%; display:grid; grid-template-columns:1.2fr 1fr; gap:clamp(3rem,8vw,9rem); align-items:end; }
	.build-heading p { max-width:31rem; }
	.contribution-grid { margin:clamp(4rem,8vw,7rem) 0 0 16.66%; display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); border-top:1px solid var(--line); }
	.contribution-grid article { padding:2.5rem 3rem 2.5rem 0; border-bottom:1px solid var(--line); }
	.contribution-grid article:nth-child(odd) { border-right:1px solid var(--line); }
	.contribution-grid article:nth-child(even) { padding-left:3rem; }
	.contribution-grid span { color:var(--accent); font:.74rem var(--mono); }
	.contribution-grid h3 { margin:2rem 0 1rem; font-size:1.55rem; }
	.results-heading { display:block; color:#fff; }
	.result-grid { margin:clamp(4rem,8vw,7rem) 0 0 16.66%; display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); border-top:1px solid rgba(255,255,255,.18); }
	.result-grid article { padding:2.8rem 2.2rem 1rem 0; border-right:1px solid rgba(255,255,255,.18); }
	.result-grid article+article { padding-left:2.2rem; }
	.result-grid article:last-child { border-right:0; }
	.result-grid strong { color:#fff; font:600 clamp(2.6rem,5vw,5rem) var(--display); letter-spacing:-.06em; }
	.result-grid h3 { color:#fff; margin:1.2rem 0 .8rem; }
	.result-grid p { color:#bcd3ef; font-size:.92rem; }
	.gallery { background:var(--surface); }
	.gallery-grid { margin-left:8.33%; display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:clamp(1.2rem,3vw,2.5rem); }
	.gallery-grid figure { margin:0; min-width:0; }
	.gallery-grid figure:first-child:nth-last-child(3) { grid-column:1/-1; }
	.gallery-grid img { width:100%; aspect-ratio:4/3; object-fit:cover; background:#f1f6fb; box-shadow:0 20px 55px rgba(7,22,43,.12); }
	.gallery-grid .contain img { object-fit:contain; }
	.lessons { background:linear-gradient(135deg,#dff0ff,#f2f8ff); }
	.lessons-heading { display:block; }
	.lessons ol { list-style:none; counter-reset:lesson; margin:clamp(4rem,7vw,6rem) 0 0 33.33%; padding:0; border-top:1px solid var(--line); }
	.lessons li { counter-increment:lesson; position:relative; padding:1.8rem 0 1.8rem 4.5rem; border-bottom:1px solid var(--line); color:var(--muted); line-height:1.7; }
	.lessons li::before { content:'0' counter(lesson); position:absolute; left:0; color:var(--accent); font:.72rem var(--mono); }
	.publication-link { display:inline-block; margin:2.5rem 0 0 33.33%; color:var(--accent); font:500 .8rem var(--mono); text-transform:uppercase; letter-spacing:.07em; text-underline-offset:.4rem; }
	.next-project { padding:clamp(4rem,8vw,7rem) clamp(1.25rem,5vw,5rem); color:#fff; background:linear-gradient(135deg,#082c60,#0b4da0); }
	.next-project p { color:#9cc9ff; font:.75rem var(--mono); text-transform:uppercase; letter-spacing:.1em; margin:0 0 1.25rem; }
	.next-project a { display:flex; align-items:center; justify-content:space-between; gap:2rem; font:600 clamp(2.2rem,5vw,5rem)/1 var(--display); letter-spacing:-.05em; text-decoration:none; }
	.next-project a span { color:var(--sky); transition:transform .2s; }
	.next-project a:hover span { transform:translateX(.5rem); }
	.contact { padding:clamp(5rem,10vw,9rem) clamp(1.25rem,5vw,5rem); color:#fff; background:var(--deep); }
	.contact p { color:#8dbcf7; font:.76rem var(--mono); text-transform:uppercase; letter-spacing:.1em; }
	.contact h2 { margin:1.5rem 0 2.5rem; }
	.contact a { font:500 clamp(1rem,2vw,1.4rem) var(--sans); text-decoration:none; border-bottom:2px solid var(--sky); padding-bottom:.45rem; }
	.contact a span { color:var(--sky); }
	footer { border-top:1px solid rgba(255,255,255,.12); color:#a9c4e4; background:#020b18; padding:2rem clamp(1.25rem,5vw,5rem); display:flex; justify-content:space-between; font:.75rem var(--mono); text-transform:uppercase; letter-spacing:.06em; }
	footer div { display:flex; gap:2rem; }
	@media (max-width:900px) {
		.hero-visual,.story-grid,.build-heading,.contribution-grid,.results-heading,.result-grid,.gallery-grid { margin-left:0; }
		.workflow { grid-template-columns:repeat(2,1fr); gap:1rem; }.workflow-item{display:block}.workflow-arrow{display:none}
		.build-heading { grid-template-columns:1fr; align-items:start; }.result-grid{grid-template-columns:1fr 1fr}.result-grid article:nth-child(2){border-right:0}.result-grid article:last-child{grid-column:1/-1;padding-left:0;border-top:1px solid rgba(255,255,255,.18)}
	}
	@media (max-width:680px) {
		.site-header{height:auto;min-height:74px;gap:1rem;padding-top:1rem;padding-bottom:1rem}nav{gap:.8rem}nav a{font-size:.65rem}.resume-nav{padding:.5rem .65rem}
		.hero-copy{margin-top:4rem}h1{font-size:clamp(3rem,14vw,5rem)}.hero-visual{margin-left:0}.hero-visual img{aspect-ratio:4/3}
		.fact-band{grid-template-columns:1fr 1fr}.fact-band div{min-height:8rem;padding:1.5rem;border-bottom:1px solid rgba(255,255,255,.16)}
		.story-grid,.contribution-grid,.gallery-grid{grid-template-columns:1fr}.story-grid{gap:3rem}.workflow{grid-template-columns:1fr}.workflow-card{min-height:0}.contribution-grid article,.contribution-grid article:nth-child(even){padding:2rem 0;border-right:0}.result-grid{grid-template-columns:1fr}.result-grid article,.result-grid article+article,.result-grid article:last-child{grid-column:auto;padding:2rem 0;border-right:0;border-top:0;border-bottom:1px solid rgba(255,255,255,.18)}
		.gallery-grid figure:first-child:nth-last-child(3){grid-column:auto}.lessons ol,.publication-link{margin-left:0}.next-project a{align-items:flex-end}footer{gap:1.5rem;flex-direction:column}
	}
	@media (max-width:520px) {
		.site-header{display:grid;grid-template-columns:auto 1fr}.site-header nav{display:flex;flex-wrap:wrap;justify-content:flex-end;gap:.55rem 1rem}.resume-nav{border:0;padding:0}.fact-band{grid-template-columns:1fr}footer div{flex-wrap:wrap;gap:1rem 1.5rem}
	}
</style>
